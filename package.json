{
  "name": "aisle-pii-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "API automation framework for the Aisle PII service (Milestone 1: service-level testing).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:api": "tsx scripts/test-all.ts --project=api",
    "test:smoke": "tsx scripts/test-all.ts --project=api --grep @smoke",
    "test:regression": "tsx scripts/test-all.ts --project=api --grep @regression",
    "test:security": "tsx scripts/test-all.ts --project=api --grep @security",
    "test:db": "tsx scripts/test-all.ts --project=api --grep @db",
    "test:poc": "tsx scripts/test-all.ts --project=api --grep @poc",
    "test:phase1": "tsx scripts/test-all.ts --project=api --grep @phase1",
    "test:debug": "PII_LOG_TO_CONSOLE=true LOG_LEVEL=debug playwright test --project=api --workers=1 --retries=0 --reporter=list",
    "test:list": "playwright test --list",
    "check-env": "tsx scripts/check-env.ts",
    "ci:sync-env": "tsx scripts/sync-ci-env.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p reporting/dashboard && tsc --noEmit -p reporting/tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "test:all": "tsx scripts/test-all.ts",
    "report": "tsx reporting/generator/generate.ts",
    "report:latest": "tsx reporting/generator/generate.ts && tsx reporting/generator/tools.ts open",
    "report:build": "tsx reporting/generator/tools.ts build",
    "report:pdf": "tsx reporting/generator/export-pdf.ts",
    "report:open": "tsx reporting/generator/tools.ts open",
    "report:dev": "tsx reporting/generator/tools.ts dev",
    "report:clean": "tsx reporting/generator/tools.ts clean",
    "report:demo": "tsx reporting/generator/generate.ts --demo && tsx reporting/generator/export-pdf.ts --demo",
    "report:demo-data": "tsx reporting/fixtures/generate-demo-data.ts",
    "report:test": "playwright test --config reporting/tests/playwright.config.ts",
    "report:mail": "tsx scripts/send-report-mail.ts",
    "report:playwright": "playwright show-report reports/html",
    "docs:traceability": "tsx reporting/generator/traceability-doc.ts && prettier --write docs/requirements-traceability.md",
    "docs:testcases": "tsx scripts/generate-test-cases-xlsx.ts",
    "docs:inventory": "tsx scripts/generate-test-inventory.ts && prettier --write --log-level warn docs/test-case-inventory.md",
    "docs:pending": "tsx scripts/generate-pending-doc.ts"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "exceljs": "^4.4.0",
    "globals": "17.12.0",
    "nodemailer": "10.0.12",
    "pdfjs-dist": "6.3.289",
    "preact": "10.29.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "optionalDependencies": {
    "mysql2": "3.24.4",
    "pg": "8.23.0"
  }
}
