{
  "name": "aisle-pii-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "API automation framework for the Aisle PII service (Milestone 1: service-level testing).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "playwright test",
    "m1:test:unit": "playwright test --project=unit",
    "m1:test:api": "tsx scripts/test-all.ts --project=api",
    "m1:test:smoke": "tsx scripts/test-all.ts --project=api --grep @smoke",
    "m1:test:regression": "tsx scripts/test-all.ts --project=api --grep @regression",
    "m1:test:security": "tsx scripts/test-all.ts --project=api --grep @security",
    "m1:test:db": "tsx scripts/test-all.ts --project=api --grep @db",
    "m1:test:poc": "tsx scripts/test-all.ts --project=api --grep @poc",
    "m1:test:phase1": "tsx scripts/test-all.ts --project=api --grep @phase1",
    "m1:test:all": "tsx scripts/test-all.ts",
    "m1:test:debug": "PII_LOG_TO_CONSOLE=true LOG_LEVEL=debug playwright test --project=api --workers=1 --retries=0 --reporter=list",
    "m1:test:list": "playwright test --list --project=unit --project=api",
    "m1:docs:traceability": "tsx reporting/generator/traceability-doc.ts && prettier --write m1/docs/requirements-traceability.md",
    "m1:docs:testcases": "tsx m1/scripts/generate-test-cases-xlsx.ts",
    "m1:docs:inventory": "tsx m1/scripts/generate-test-inventory.ts && prettier --write --log-level warn m1/docs/test-case-inventory.md",
    "m1:docs:pending": "tsx m1/scripts/generate-pending-doc.ts",
    "m2:test": "REPORTS_DIR=reports/m2 playwright test --project=m2-api --workers=2",
    "m2:test:smoke": "REPORTS_DIR=reports/m2 playwright test --project=m2-api --workers=2 --grep @smoke",
    "m2:test:unit": "REPORTS_DIR=reports/m2-unit playwright test --project=m2-unit",
    "m2:test:list": "playwright test --list --project=m2-api",
    "m2:report": "tsx reporting/generator/generate.ts --milestone m2",
    "m2:report:open": "tsx reporting/generator/tools.ts open --m2",
    "m2:contracts:record": "M2_CONTRACTS_RECORD=true REPORTS_DIR=reports/m2-record playwright test --project=m2-api --workers=2 --grep \"-(CONTRACT|PARAM|BODY|STATE|REPEAT) \" ; tsx m2/scripts/m2-contracts-review.ts",
    "m2:contracts:review": "tsx m2/scripts/m2-contracts-review.ts",
    "m2:accounts:cleanup": "tsx m2/scripts/m2-accounts-cleanup.ts",
    "m2:contracts:approve": "tsx m2/scripts/m2-contracts-approve.ts",
    "m2:docs": "tsx m2/scripts/generate-m2-workbook.ts && prettier --write --log-level warn m2/docs/m2-test-design-summary.md && npm run docs:api",
    "docs:api": "tsx scripts/api-docs/export.ts",
    "docs:api:publish": "tsx scripts/api-docs/publish.ts",
    "check-env": "tsx scripts/check-env.ts",
    "ci:sync-env": "tsx scripts/sync-ci-env.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p reporting/dashboard && tsc --noEmit -p reporting/tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run m1:test:unit && npm run m2:test:unit",
    "report": "tsx reporting/generator/generate.ts",
    "report:latest": "tsx reporting/generator/generate.ts && tsx reporting/generator/tools.ts open",
    "report:build": "tsx reporting/generator/tools.ts build",
    "report:pdf": "tsx reporting/generator/export-pdf.ts",
    "report:open": "tsx reporting/generator/tools.ts open",
    "report:dev": "tsx reporting/generator/tools.ts dev",
    "report:clean": "tsx reporting/generator/tools.ts clean",
    "report:demo": "tsx reporting/generator/generate.ts --demo && tsx reporting/generator/export-pdf.ts --demo",
    "report:demo-data": "tsx reporting/fixtures/generate-demo-data.ts",
    "report:test": "playwright test --config reporting/tests/playwright.config.ts",
    "report:mail": "tsx scripts/send-report-mail.ts",
    "report:playwright": "playwright show-report reports/html"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "exceljs": "^4.4.0",
    "globals": "17.12.0",
    "nodemailer": "10.0.12",
    "pdfjs-dist": "6.3.289",
    "preact": "10.29.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "optionalDependencies": {
    "mysql2": "3.24.4",
    "pg": "8.23.0"
  }
}
