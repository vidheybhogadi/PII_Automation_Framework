# =============================================================================================
# Aisle PII API automation — environment template.
# Copy to .env (git-ignored) and fill in. PLACEHOLDERS ONLY — never commit real values.
# Every value starting with PENDING_ is a dummy waiting on the PII backend team. The framework treats it as
# "not set" (it is never sent anywhere). Full list and owners: PENDING-PLACEHOLDERS.md
# Where to obtain each value: docs/setup-guide.md §3. Validate with: npm run check-env
# =============================================================================================

# ---- Target service ---------------------------------------------------------------------------
# local | dev | qa | staging
PII_ENVIRONMENT=PENDING_ENVIRONMENT_NAME   # [local]
# Development default from the guide is http://127.0.0.1:8001 — replace per environment.
PII_BASE_URL=PENDING_PII_BASE_URL
PII_HTTP_TIMEOUT_MS=15000
# Extra attempts for READ-ONLY endpoints on HTTP 503 (bounded exponential backoff + jitter). 0 = off.
PII_RETRY_MAX_ATTEMPTS=2
PII_RETRY_BASE_DELAY_MS=250
# "all" or comma-separated keys: healthReady,writePii,readPii,searchPii,batchReadPii,
# createTransientPhone,resolveTransientPhone,promoteTransientPhone,createFreeTextKey,readFreeTextKey,revokeFreeTextKey
PII_ENDPOINTS_IN_SCOPE=all

# ---- Calling-service identities (Ed25519, unencrypted PKCS#8 PEM) -------------------------------
# Prefer *_PRIVATE_KEY_FILE (path to a PEM file outside the repo, chmod 600).
# Alternatively *_PRIVATE_KEY with PEM text using literal \n, or base64 of the PEM. Never both.
# primary   = full test permissions (see docs/setup-guide.md §4)
PII_CALLER_PRIMARY_ID=PENDING_PRIMARY_CALLER_ID
PII_CALLER_PRIMARY_PRIVATE_KEY_FILE=./secrets/primary-caller.pem
# secondary = second caller with the SAME permissions (caller-ownership isolation tests)
PII_CALLER_SECONDARY_ID=PENDING_SECONDARY_CALLER_ID
PII_CALLER_SECONDARY_PRIVATE_KEY_FILE=./secrets/secondary-caller.pem
# limited   = restricted permission set (authorization tests; docs/setup-guide.md §4)
PII_CALLER_LIMITED_ID=PENDING_LIMITED_CALLER_ID
PII_CALLER_LIMITED_PRIVATE_KEY_FILE=./secrets/limited-caller.pem

# ---- Test data (NON-PRODUCTION ONLY) -------------------------------------------------------------
PII_TEST_TENANT_ID=PENDING_TEST_TENANT_ID
PII_TEST_TENANT_ID_SECONDARY=PENDING_TEST_TENANT_ID_SECONDARY
PII_TEST_RUN_PREFIX=qa-auto
# Approved non-deliverable domain for synthetic emails.
PII_TEST_EMAIL_DOMAIN=PENDING_TEST_EMAIL_DOMAIN
# Comma-separated team-APPROVED 10-digit test phone numbers (at least 2). Do not use real people's numbers.
PII_TEST_PHONES=PENDING_APPROVED_10_DIGIT_TEST_PHONES
# OPTIONAL — leave empty. The team tests with 10-digit numbers only, so the 8/15-digit limit test (PII-NRM-004)
# is skipped. Fill both with approved numbers of exactly 8 and 15 digits only if you want that edge tested.
PII_TEST_PHONE_8_DIGITS=
PII_TEST_PHONE_15_DIGITS=
# A field name the catalog does NOT contain (default shown).
PII_UNSUPPORTED_FIELD=QA_AUTOMATION_UNKNOWN_FIELD
# A catalog field that exists but is NOT searchable (ask backend; leave empty if unknown).
PII_NON_SEARCHABLE_FIELD=PENDING_Q18_NON_SEARCHABLE_FIELD   # tech doc v3: FIRST_NAME (names are not searchable) — depends on Q-31

# ---- Server limits for the target environment (guide documents the DEVELOPMENT values) ------------
# While a limit is PENDING_, the guide's development value (in brackets) is used.
PII_BATCH_MAX_ITEMS=PENDING_BATCH_MAX_ITEMS   # [50]
PII_SEARCH_DEFAULT_LIMIT=PENDING_SEARCH_DEFAULT_LIMIT   # [10]
PII_TRANSIENT_TTL_MIN_SECONDS=PENDING_TRANSIENT_TTL_MIN_SECONDS   # [300]
PII_TRANSIENT_TTL_MAX_SECONDS=PENDING_TRANSIENT_TTL_MAX_SECONDS   # [604800]
# Maximum request body size in bytes. 1048576 (1 MiB) is the tech doc v3 §12.4 default — confirm for QA (Q-22).
PII_MAX_BODY_BYTES=1048576
PII_CLOCK_SKEW_TOLERANCE_SECONDS=120

# ---- Feature switches --------------------------------------------------------------------------
# Waits (TTL_MIN + skew) seconds to observe real expiry. Use only with a short-TTL environment.
PII_ENABLE_TTL_EXPIRY_TEST=PENDING_Q12_SHORT_TTL_ENVIRONMENT   # [false]
# true in any non-development environment: /docs/signature must not be exposed.
PII_SIGNATURE_HELPER_MUST_BE_DISABLED=PENDING_Q23_SIGNATURE_HELPER_DISABLED   # [false]

# ---- Database validation (technology/schema NOT documented — docs/database-setup.md) --------------
# none | postgres | mysql
DB_ENGINE=postgres   # tech doc v3 §1.4: PostgreSQL 15+
DB_HOST=PENDING_DB_HOST
DB_PORT=PENDING_DB_PORT
DB_NAME=PENDING_DB_NAME
# READ-ONLY user
DB_USER=PENDING_DB_READONLY_USER
DB_PASSWORD=PENDING_DB_READONLY_PASSWORD
DB_SSL=true
DB_QUERIES_FILE=config/db-queries.json
DB_CONNECT_TIMEOUT_MS=10000

# ---- Logging -----------------------------------------------------------------------------------
# debug | info | warn | error   (all output is redacted)
LOG_LEVEL=info
PII_LOG_TO_CONSOLE=false
