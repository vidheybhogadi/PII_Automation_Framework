# =============================================================================================
# Aisle PII API automation — environment template.
#
#   QA automation → Aisle PII facade (Bearer token) → PII service → PII DB (read-only checks)
#
# Copy to .env (git-ignored) and fill in. PLACEHOLDERS ONLY — never commit real values.
# Any value starting with PENDING_ is treated as "not set". Validate with: npm run check-env
# =============================================================================================

# ---- Target: the Aisle PII facade ---------------------------------------------------------------
# Label for reports: local | dev | qa | staging
PII_ENVIRONMENT=staging
# Verified staging facade (testa3 does not resolve). Change only if Dev gives another environment.
AISLE_BASE_URL=https://testa2.aisle.co/V1
# The Aisle testing token, sent as "Authorization: Bearer <token>". SECRET: .env or CI secret only.
AISLE_TEST_TOKEN=
# The first health call on staging can take ~15 s (cold start), so allow 30 s.
PII_HTTP_TIMEOUT_MS=30000
# Extra attempts for READ-ONLY endpoints on HTTP 503 (bounded exponential backoff + jitter). 0 = off.
PII_RETRY_MAX_ATTEMPTS=2
PII_RETRY_BASE_DELAY_MS=250
# "all" or comma-separated keys: healthReady,writePii,readPii,searchPii,batchReadPii,
# createTransientPhone,resolveTransientPhone,promoteTransientPhone,createFreeTextKey,readFreeTextKey,revokeFreeTextKey
PII_ENDPOINTS_IN_SCOPE=all

# ---- Test data (NON-PRODUCTION ONLY) -------------------------------------------------------------
# Staging accepts made-up user IDs, so every test generates its own ("<prefix>-<timestamp>-<random>-w…").
PII_TEST_RUN_PREFIX=qa-auto
# OPTIONAL fixed test users — only if Dev asks QA to use specific approved test users. Leave empty otherwise.
AISLE_TEST_USER_ID=
AISLE_TEST_OTHER_USER_ID=
# Approved non-deliverable domain for synthetic emails (.test is reserved and can never receive mail).
AISLE_TEST_EMAIL_DOMAIN=example.test
# Comma-separated team-APPROVED test phone numbers. Never use a real person's number. Empty = phone tests BLOCKED.
AISLE_TEST_PHONES=PENDING_APPROVED_TEST_PHONES
# A field name the facade does not support (unknown-field test).
PII_UNSUPPORTED_FIELD=QA_AUTOMATION_UNKNOWN_FIELD

# ---- Milestone 2: Aisle business APIs (npm run m2:test) — reuses AISLE_TEST_TOKEN as TEST_TOKEN ----------
# Origin of the Aisle app (M2 paths already start with /V1). Default: origin of AISLE_BASE_URL (https://testa2.aisle.co).
# M2_BASE_URL=
# app_version / device_type headers for app routes (staging accepted 10.0.0 and 99.99.99 on 2026-10-23).
# M2_APP_VERSION=10.0.0
# M2_DEVICE_TYPE=android
# Phone login as the app sends it (m2/docs/onboarding-flow.md): phone code id for +91, and the app's static
# signature_v1 — a SECRET (never commit, log or print it). Optional; without it the OTP request omits it.
M2_PHONE_CODE_ID=242
M2_LOGIN_SIGNATURE_V1=
# Create NEW synthetic staging accounts (+91 10…, never 106…, OTP 1234). Default off: cases needing one are Blocked.
# Created accounts are tracked in reports/m2/accounts/ (git-ignored; numbers, never tokens).
# M2_CREATE_ACCOUNTS=false
# Dev-provided synthetic accounts (M2Q-36): onboarded ones, a connected pair, special states (M2Q-32).
# M2_ONBOARDED_ACCOUNTS=10xxxxxxxx,10xxxxxxxx
# M2_CONNECTED_ACCOUNTS=10xxxxxxxx,10xxxxxxxx
# M2_ACCOUNT_UNMIGRATED= / M2_ACCOUNT_HIDDEN_NAME= / M2_ACCOUNT_DEACTIVATED= ; M2_VALUE_HIDDEN_NAME_FULL=
# Catalogue values for Dev cURL placeholders override the config defaults (m2-config.ts DEFAULT_VALUES), e.g.
# M2_VALUE_FAITH_ID=, M2_VALUE_TRAIT_ID=. Account ids (REF, OTHER_REF, USER_ID, CONVERSATION_ID, REQUEST_ID, PHOTO_ID_*)
# are NEVER read from here — they always come from the suite's own synthetic accounts.
# Wait for staging's auto-approval of a suite account (approved-state routes), default 3 min:
# M2_APPROVAL_WAIT_MS=180000
# App user → PII user_id mapping once Dev confirms it (M2Q-37): app-id ; tenant (default aisle)
# M2_PII_USER_ID_SOURCE=
# M2_PII_TENANT=aisle
# Dev windows (Dev-assisted cases only): M2_PII_OUTAGE_WINDOW=true ; M2_PAYMENT_SANDBOX=true
# (Read gates are OFF on testa2 and not switchable by QA — M2Q-02; gate-ON parts wait for Dev, M2Q-43.)

# ---- Database validation (READ-ONLY; schema from Dev — m1/docs/database-setup.md) ---------------------
# none | postgres | mysql. While "none", the @db tests are BLOCKED (BQ-04), not failed.
DB_ENGINE=none
DB_HOST=PENDING_DB_HOST
DB_PORT=PENDING_DB_PORT
DB_NAME=PENDING_DB_NAME
# READ-ONLY user (SELECT only)
DB_USER=PENDING_DB_READONLY_USER
DB_PASSWORD=PENDING_DB_READONLY_PASSWORD
DB_SSL=true
DB_QUERIES_FILE=m1/config/db-queries.json
DB_CONNECT_TIMEOUT_MS=10000

# ---- Logging -----------------------------------------------------------------------------------
# debug | info | warn | error   (all output is redacted; the token is never logged)
LOG_LEVEL=info
PII_LOG_TO_CONSOLE=false

# ---- Report email (npm run report:mail) — optional locally; CI uses GitHub secrets/variables ------
# Microsoft 365: a service mailbox with SMTP AUTH enabled. `npm run report:mail -- --dry-run` needs only REPORT_MAIL_TO.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_MAIL_FROM=
# Comma-separated recipients
REPORT_MAIL_TO=vidhey.bhogadi@infoedge.com

# Aisle API Docs publishing (npm run docs:api:publish): local clone of https://github.com/vidheybhogadi/API_Guide
# API_DOCS_REPO_DIR=/Users/you/code/API_Guide
