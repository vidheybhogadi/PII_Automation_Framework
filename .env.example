# =============================================================================================
# Aisle PII API automation — environment template.
# Copy to .env (git-ignored) and fill in. PLACEHOLDERS ONLY — never commit real values.
# Where to obtain each value: docs/setup-guide.md §3. Validate with: npm run check-env
# =============================================================================================

# ---- Target service ---------------------------------------------------------------------------
# local | dev | qa | staging
PII_ENVIRONMENT=local
# Development default from the guide is http://127.0.0.1:8001 — replace per environment.
PII_BASE_URL=http://127.0.0.1:8001
PII_HTTP_TIMEOUT_MS=15000
# Extra attempts for READ-ONLY endpoints on HTTP 503 (bounded exponential backoff + jitter). 0 = off.
PII_RETRY_MAX_ATTEMPTS=2
PII_RETRY_BASE_DELAY_MS=250
# "all" or comma-separated keys: healthReady,writePii,readPii,searchPii,batchReadPii,
# createTransientPhone,resolveTransientPhone,promoteTransientPhone,createFreeTextKey,readFreeTextKey,revokeFreeTextKey
PII_ENDPOINTS_IN_SCOPE=all

# ---- Calling-service identities (Ed25519, unencrypted PKCS#8 PEM) -------------------------------
# Prefer *_PRIVATE_KEY_FILE (path to a PEM file outside the repo, chmod 600).
# Alternatively *_PRIVATE_KEY with PEM text using literal \n, or base64 of the PEM. Never both.
# primary   = full test permissions (see docs/setup-guide.md §4)
PII_CALLER_PRIMARY_ID=<registered-caller-id>
PII_CALLER_PRIMARY_PRIVATE_KEY_FILE=./secrets/primary-caller.pem
# secondary = second caller with the SAME permissions (caller-ownership isolation tests)
PII_CALLER_SECONDARY_ID=
PII_CALLER_SECONDARY_PRIVATE_KEY_FILE=
# limited   = restricted permission set (authorization tests; docs/setup-guide.md §4)
PII_CALLER_LIMITED_ID=
PII_CALLER_LIMITED_PRIVATE_KEY_FILE=

# ---- Test data (NON-PRODUCTION ONLY) -------------------------------------------------------------
PII_TEST_TENANT_ID=<approved-non-prod-tenant>
PII_TEST_TENANT_ID_SECONDARY=<second-approved-non-prod-tenant>
PII_TEST_RUN_PREFIX=qa-auto
# Approved non-deliverable domain for synthetic emails.
PII_TEST_EMAIL_DOMAIN=<approved-test-domain>
# Comma-separated team-APPROVED test phone numbers. Do not use real people's numbers.
PII_TEST_PHONES=
# Approved numbers with exactly 8 and exactly 15 digits (normalization boundary tests).
PII_TEST_PHONE_8_DIGITS=
PII_TEST_PHONE_15_DIGITS=
# A field name the catalog does NOT contain (default shown).
PII_UNSUPPORTED_FIELD=QA_AUTOMATION_UNKNOWN_FIELD
# A catalog field that exists but is NOT searchable (ask backend; leave empty if unknown).
PII_NON_SEARCHABLE_FIELD=

# ---- Server limits for the target environment (guide documents the DEVELOPMENT values) ------------
PII_BATCH_MAX_ITEMS=50
PII_SEARCH_DEFAULT_LIMIT=10
PII_TRANSIENT_TTL_MIN_SECONDS=300
PII_TRANSIENT_TTL_MAX_SECONDS=604800
# Configured maximum request body size in bytes (ask backend). Empty = 413 test blocked.
PII_MAX_BODY_BYTES=
PII_CLOCK_SKEW_TOLERANCE_SECONDS=120

# ---- Feature switches --------------------------------------------------------------------------
# Waits (TTL_MIN + skew) seconds to observe real expiry. Use only with a short-TTL environment.
PII_ENABLE_TTL_EXPIRY_TEST=false
# true in any non-development environment: /docs/signature must not be exposed.
PII_SIGNATURE_HELPER_MUST_BE_DISABLED=false

# ---- Database validation (technology/schema NOT documented — docs/database-setup.md) --------------
# none | postgres | mysql
DB_ENGINE=none
DB_HOST=
DB_PORT=
DB_NAME=
# READ-ONLY user
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_QUERIES_FILE=config/db-queries.json
DB_CONNECT_TIMEOUT_MS=10000

# ---- Logging -----------------------------------------------------------------------------------
# debug | info | warn | error   (all output is redacted)
LOG_LEVEL=info
PII_LOG_TO_CONSOLE=false
